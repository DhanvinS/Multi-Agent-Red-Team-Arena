# Copy this file to .env and fill in your keys

# Required for OpenAI-based attackers, defenders, and judge
OPENAI_API_KEY=sk-...

# Required for Anthropic-based judge (recommended)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama local server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Judge configuration
# Options: anthropic | openai
JUDGE_PROVIDER=anthropic
# Anthropic model options: claude-haiku-4-5-20251001 | claude-sonnet-4-6
# OpenAI model options: gpt-4o-mini | gpt-4o
JUDGE_MODEL=claude-haiku-4-5-20251001

# Arena settings
DEFAULT_ROUNDS=50
ELO_K_FACTOR=32
ELO_INITIAL_RATING=1200
